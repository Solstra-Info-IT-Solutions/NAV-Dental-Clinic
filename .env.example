# Copy to .env.local for local development. Never commit real values.
# Full descriptions: docs/ARCHITECTURE.md §10 (DEPLOYMENT.md from Phase 10).

# --- Public (inlined into the browser bundle; never put secrets here) ---
# Canonical site origin, no trailing slash. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (used from Phase 3 onwards) ---
# MongoDB Atlas connection string (database user with readWrite on one database only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nav_dental

# Admin authentication (Phase 6). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Transactional email (Phase 4/5). Leave empty to record notifications as "skipped_not_configured".
RESEND_API_KEY=
EMAIL_FROM="NAV Dental Clinic <appointments@example.com>"

# Salt for hashing IP addresses in rate limiting. Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=replace-with-a-long-random-string

# Bearer secret for /api/cron/* (Vercel Cron). Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string

# Optional: Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Development only (used solely by the in-memory database wrapper, never with MONGODB_URI) ---
# Owner account created in the temporary in-memory database. If unset, a random password is printed at startup.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
